# Keep real credentials in your local environment or deployment secret manager.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Generate independent random values for both tokens. Never reuse your OpenAI API key.
ASSISTANT_ACCESS_TOKEN=
ASSISTANT_ADMIN_TOKEN=

# Local SQLite vector store. The file is ignored by Git.
RAG_DB_PATH=data/assistant.sqlite3
RAG_MIN_RELEVANCE=0.18
