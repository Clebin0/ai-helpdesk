# Local LLM through Ollama. No hosted inference API is called by this configuration.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_CHAT_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=160
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_THREADS=6

# PostgreSQL + pgvector. Docker Compose overrides the hostname to "postgres".
POSTGRES_DB=ai_helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=local_dev_change_me
DATABASE_URL=postgresql://helpdesk:local_dev_change_me@localhost:5432/ai_helpdesk
POSTGRES_CONNECT_TIMEOUT=5

# Embeddings are generated locally by FastEmbed. First run downloads model files.
RAG_EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_MIN_RELEVANCE=0.18

# Independent API access tokens. Generate separate random values; never commit .env.
ASSISTANT_ACCESS_TOKEN=
ASSISTANT_ADMIN_TOKEN=

# SQLite is retained as a compatibility fallback when DATABASE_URL is not set.
RAG_DB_PATH=data/assistant.sqlite3
