# Local LLM: no inference API credits or external chat billing.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_CHAT_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=160
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_THREADS=6

# Optional Hugging Face cloud provider. Requires available inference credits.
HF_TOKEN=
HF_CHAT_MODEL=Qwen/Qwen3.5-9B:cheapest

# Local semantic embeddings: first run downloads model files; inference stays local.
RAG_EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional legacy OpenAI provider.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Independent API access tokens. Never reuse provider credentials.
ASSISTANT_ACCESS_TOKEN=
ASSISTANT_ADMIN_TOKEN=

# Local SQLite vector store. The file is ignored by Git.
RAG_DB_PATH=data/assistant.sqlite3
RAG_MIN_RELEVANCE=0.18
