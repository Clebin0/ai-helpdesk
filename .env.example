# Hugging Face Inference Providers (chat). Create a fine-grained token
# with the "Make calls to Inference Providers" permission. Never commit this file.
LLM_PROVIDER=huggingface
HF_TOKEN=
HF_CHAT_MODEL=Qwen/Qwen3.5-9B:cheapest

# Local semantic embeddings: first run downloads the model; inference is CPU-only.
RAG_EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional legacy provider configuration (only used when explicitly selected).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Generate two independent random values; never reuse an API key.
ASSISTANT_ACCESS_TOKEN=
ASSISTANT_ADMIN_TOKEN=

# Local SQLite vector store. The file is ignored by Git.
RAG_DB_PATH=data/assistant.sqlite3
RAG_MIN_RELEVANCE=0.18
